<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    
    <!-- Assembly Configuration -->
    <AssemblyName>Itenso.TimePeriod</AssemblyName>
    <RootNamespace>Itenso.TimePeriod</RootNamespace>
    <AssemblyVersion>2.1.3.0</AssemblyVersion>
    <FileVersion>2.1.3.0</FileVersion>
    
    <!-- Strong Name Signing -->
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>TimePeriodLibrary.snk</AssemblyOriginatorKeyFile>
    
    <!-- Package Identity -->
    <PackageId>HEFLO.TimePeriodLibrary.NET</PackageId>
    <Version>1.0.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    
    <!-- Package Metadata -->
    <Authors>Jani Giannoudis, HEFLO</Authors>
    <Company>HEFLO</Company>
    <Product>HEFLO BPM</Product>
    <Copyright>(c) 2011-2023 by Jani Giannoudis, Switzerland</Copyright>
    <Description>Extensive time period calculations and individual calendar periods - HEFLO customized version for .NET 8.0</Description>
    <PackageProjectUrl>https://www.heflo.com/</PackageProjectUrl>
    
    <!-- Package Tags -->
    <PackageTags>heflo;time;period;calendar;date;datetime;calculations;dotnet8</PackageTags>
    <PackageReleaseNotes>HEFLO customized version - Migrated to .NET 8.0 - Published via AWS CodeArtifact</PackageReleaseNotes>
    
    <!-- Repository Info -->
    <RepositoryUrl>https://github.com/Giannoudis/TimePeriodLibrary</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateSerializationAssemblies>Auto</GenerateSerializationAssemblies>
    <DebugType>none</DebugType>
    <DebugSymbols>False</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="Properties\AssemblyInfo.Title.Desktop.cs" />
    <Compile Remove="Properties\AssemblyInfo.Title.Pcl.cs" />
    <Compile Remove="Properties\AssemblyInfo.Title.Silverlight.cs" />
    <Compile Remove="Properties\AssemblyInfo.Title.WindowsPhone.cs" />
    <Compile Remove="Properties\VersionInfo.cs" />
    <Compile Remove="TimeLineMomentCollection.Desktop.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>